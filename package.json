{
  "name": "bit-field",
  "version": "1.11.0",
  "description": "rendering bit field diagram from the description",
  "bin": {
    "bitfield": "./bin/bitfield.js"
  },
  "main": "lib/index.js",
  "scripts": {
    "test": "eslint lib/ test/ && c8 -r text -r lcov mocha",
    "build": "esbuild lib/index.js --bundle --format=iife --global-name=bitfield --footer:js=\"(function(r){if(typeof define=='function'&&define.amd){define([],()=>bitfield)}else if(typeof module=='object'&&module.exports){module.exports=bitfield}else{r.bitfield=bitfield}})(typeof self!=='undefined'?self:this);\" --outfile=build/bitfield.js",
    "prepare": "npm run build",
    "alpha": "node bin/bitfield.js --input test/alpha.json --hspace 800 > test/alpha.svg"
  },
  "files": [
    "build/bitfield.js",
    "bin/*",
    "lib/*"
  ],
  "unpkg": "build/bitfield.js",
  "author": "Aliaksei Chapyzhenka",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "onml": "^2.1.0",
    "tspan": "^0.4.0"
  },
  "devDependencies": {
    "@drom/eslint-config": "^1.0.0",
    "ajv": "^8.20.0",
    "c8": "^10.1.3",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsof": "^0.5.0",
    "mocha": "^12.0.3"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavedrom/bitfield.git"
  },
  "keywords": [
    "svg",
    "bitfield"
  ],
  "bugs": {
    "url": "https://github.com/wavedrom/bitfield/issues"
  },
  "homepage": "https://github.com/wavedrom/bitfield#readme"
}
